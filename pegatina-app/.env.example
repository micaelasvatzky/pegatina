# Copiá este archivo a .env.local y completá con tus credenciales reales.
# ⚠️ NUNCA comitees .env.local (ya está en .gitignore).

# URI de conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Secreto para firmar las sesiones JWT (usá un valor largo y aleatorio)
JWT_SECRET=una-clave-muy-larga-y-secreta
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
# Mercado Pago (Checkout Pro via Orders) - credenciales de PRUEBA se obtienen en Tus integraciones > Credenciales de prueba
MP_ACCESS_TOKEN=TEST-xxxx
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-xxxx

# OAuth para que los ilustradores conecten su cuenta MP (se obtienen en Credenciales de PRODUCCION)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Secret del webhook (panel MP > Webhooks > Configurar notificaciones)
MP_NOTIFICATION_SECRET=
# URL publica de la app (para OAuth redirect y back_urls): Vercel o local via ngrok
APP_URL=
